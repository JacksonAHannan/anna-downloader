{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "outDir": "./dist"
  },
  "include": ["*.ts"],
  "exclude": ["ui", "node_modules", "**/*.test.ts"],
  "ts-node": {
    "esm": false,
    "transpileOnly": true
  }
}
