# Anna's Archive Configuration

# Required: Your Anna's Archive secret key for fast downloads
ANNAS_SECRET_KEY=your_secret_key_here
# Search catalog and member-download API currently use separate hosts.
ANNAS_BASE_URL=https://annas-archive.is
ANNAS_DOWNLOAD_BASE_URL=https://annas-archive.gl

# Optional: Output folder for downloaded books (default: ./downloads)
OUTPUT_FOLDER=./downloads

# Optional: Preferred book format (e.g., pdf, epub, mobi)
PREFERRED_FORMAT=pdf

# Optional: Preferred language (e.g., English, Spanish)
PREFERRED_LANGUAGE=English

# Optional: Editions from a publisher whose name contains this text rank higher (e.g., Penguin).
# Also editable from the web UI. When set, preliminary match review only auto-accepts exact
# matches; when unset, it auto-accepts matches above 80% confidence like a normal download run.
PREFERRED_PUBLISHER=

# Optional: Maximum number of books to download (default: unlimited)
MAX_DOWNLOADS=10
# Optional: Google Books API key used by the local book-list builder
GOOGLE_BOOKS_KEY=your_google_books_key_here
