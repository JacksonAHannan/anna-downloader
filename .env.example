# Anna's Archive Configuration

# Required: Your Anna's Archive secret key for fast downloads
ANNAS_SECRET_KEY=your_secret_key_here
# Local metadata is the preferred search source. Build this SQLite file with
# `npm run metadata:cli -- index`; it is always queried before an enabled fallback.
ANNA_METADATA_INDEX=
# Trusted download origin. Search never falls back to this host automatically.
ANNAS_DOWNLOAD_BASE_URL=https://annas-archive.gl
# Explicit opt-in fallback for operators who accept sending book titles to an
# unaffiliated, untrusted HTML catalog. Results are MD5 leads only, restricted
# to PDF/EPUB, visibly labeled, and require manual review before download.
ENABLE_UNTRUSTED_CATALOG_SEARCH=false
UNTRUSTED_CATALOG_BASE_URL=https://annas-archive.is
# Optional comma-separated origins tried from left to right.
UNTRUSTED_CATALOG_BASE_URLS=
ANNAS_DOWNLOAD_BASE_URLS=
# Optional extra exact hostnames trusted for candidate links. No wildcards.
ANNAS_TRUSTED_HOSTS=
# Optional fast-download server preference. Anna's API domain_index values are
# tried from left to right; current responsive partner servers are first.
ANNAS_FAST_DOMAIN_INDEXES=6,7,1,2,8,9,0

# Optional: Output folder for downloaded books (default: ./downloads)
OUTPUT_FOLDER=./downloads
# Optional local UI port (the server always binds to loopback).
UI_PORT=4173
# Optional: Recursively scan an existing library when importing CSVs and mark
# conservatively matched rows as downloaded. Defaults to OUTPUT_FOLDER.
LIBRARY_SCAN_FOLDER=

# Optional: Preferred language (e.g., English, Spanish)
PREFERRED_LANGUAGE=English

# Optional: Editions from a publisher whose name contains this text rank higher (e.g., Penguin).
# Also editable from the web UI. Trusted local matches may auto-accept according
# to this preference; untrusted-catalog results always require manual review.
PREFERRED_PUBLISHER=

# Optional: Maximum number of books to download (default: unlimited)
MAX_DOWNLOADS=10
# Optional: configure one or more providers for the LLM book-list builder.
# Keys remain on the local server. Legacy OPENAI_KEY, ANTHROPIC_KEY, and
# OPENROUTER_KEY names are also supported.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
COHERE_API_KEY=
PERPLEXITY_API_KEY=

# Optional provider model overrides
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_MODEL=openai/gpt-5-mini
XAI_MODEL=grok-4-fast
MISTRAL_MODEL=mistral-small-latest
GROQ_MODEL=llama-3.3-70b-versatile
DEEPSEEK_MODEL=deepseek-chat
COHERE_MODEL=command-a-03-2025
PERPLEXITY_MODEL=sonar
