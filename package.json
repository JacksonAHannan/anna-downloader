{
  "name": "anna-downloader",
  "version": "1.0.0",
  "description": "Local-first CSV reading-list matcher and download workflow with reviewable edition selection.",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JacksonAHannan/anna-downloader.git"
  },
  "bugs": {
    "url": "https://github.com/JacksonAHannan/anna-downloader/issues"
  },
  "homepage": "https://github.com/JacksonAHannan/anna-downloader#readme",
  "keywords": ["books", "csv", "metadata", "reading-list", "typescript"],
  "engines": { "node": ">=22.13" },
  "scripts": {
    "build": "tsc && npm run ui:build",
    "start": "node dist/main.js",
    "ui": "npm run build && node dist/server.js",
    "ui:dev": "concurrently \"tsc --watch\" \"node --watch-path=dist dist/server.js\" \"vite --config ui/vite.config.ts\"",
    "ui:build": "vite build --config ui/vite.config.ts",
    "metadata:cli": "ts-node metadata-cli.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui/tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "check": "npm run typecheck && npm test -- --runInBand && npm run ui:build"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "cheerio": "^1.1.2",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "dotenv": "^17.2.2",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "axios-mock-adapter": "^2.1.0",
    "concurrently": "^9.2.1",
    "jest": "^30.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.9"
  }
}
